JWT_SECRET=cambia_questa_stringa_segreta_almeno_32_caratteri
PORT=3001

# Percorso del database SQLite (default: server/walletai.db)
# DATABASE_PATH=/var/data/walletai.db

# Livello log: debug | info | warn | error (default: info)
# LOG_LEVEL=info

# Numero di proxy fidati davanti al server.
# Su Render lascia 1; in locale puoi usare false.
# TRUST_PROXY=1

# ── AI locale (Ollama) ──────────────────────────────────────────
# Usa questa configurazione quando esegui l'app sul tuo computer.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_API_KEY=   ← lascia vuoto per Ollama locale

# Timeout della chiamata AI in millisecondi (default: 3000 locale, 8000 cloud)
# AI_TIMEOUT_MS=8000
# Metti true per disabilitare l'AI (utile in test/offline)
# AI_DISABLED=false

# ── AI cloud gratuita (Groq) ────────────────────────────────────
# Alternativa per il deploy su Render/Railway/ecc.
# 1. Crea un account su https://console.groq.com
# 2. Genera una API key
# 3. Decommenta e compila le righe qui sotto (commenta le righe Ollama sopra)
#
# OLLAMA_URL=https://api.groq.com/openai
# OLLAMA_MODEL=llama-3.1-8b-instant
# OLLAMA_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── AI cloud gratuita (OpenRouter) ─────────────────────────────
# Alternativa con più modelli disponibili (incluso qwen2.5)
# 1. Crea un account su https://openrouter.ai
# 2. Genera una API key (crediti gratuiti all'iscrizione)
#
# OLLAMA_URL=https://openrouter.ai/api
# OLLAMA_MODEL=qwen/qwen-2.5-7b-instruct:free
# OLLAMA_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Backup automatico su GitHub Gist (opzionale) ────────────────
# Token classico con scope "gist". Lascia GIST_ID vuoto al primo deploy:
# il server lo crea e lo stampa nei log.
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
# GITHUB_GIST_ID=

# ── Produzione ──────────────────────────────────────────────────
# URL del frontend Netlify, separati da virgola se sono più di uno
# (es: https://walletai.netlify.app,https://www.walletai.it)
ALLOWED_ORIGIN=

# Se il frontend chiama il backend direttamente (senza proxy Netlify),
# imposta l'URL al build time. Se usi il proxy /api/* di Netlify, lascia vuoto.
# VITE_API_URL=https://walletai-backend.onrender.com
